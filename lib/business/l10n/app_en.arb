  "command_draw_polyline_desc": "Draws a connected sequence of segments as one polyline entity. Pass a points array to create it non-interactively.",
  "@command_draw_polyline_desc": {
    "description": "command draw polyline desc"
  },
  "command_draw_spline_desc": "Draws a clamped B-spline. Control-point mode pulls the curve toward the clicks and only guarantees the ends. Fit mode interpolates every point. Pass a points array to create it non-interactively.",
  "@command_draw_spline_desc": {
    "description": "command draw spline desc"
  },
  "command_draw_rectangle_desc": "Draws an axis-aligned rectangle as a closed polyline.",
  "@command_draw_rectangle_desc": {
    "description": "command draw rectangle desc"
  },
  "command_draw_circle_desc": "Draws a circle from a centre point and a radius.",
  "@command_draw_circle_desc": {
    "description": "command draw circle desc"
  },
  "command_draw_circle_2p_desc": "Draws a circle whose diameter is the segment between two points.",
  "@command_draw_circle_2p_desc": {
    "description": "command draw circle 2p desc"
  },
  "command_draw_circle_3p_desc": "Draws the unique circle that passes through three specified points.",
  "@command_draw_circle_3p_desc": {
    "description": "command draw circle 3p desc"
  },
  "command_draw_circle_ttr_desc": "Draws a circle of a given radius tangent to two lines, circles or arcs. The pick on each object chooses the side (and, for a circle, external versus internal tangent).",
  "@command_draw_circle_ttr_desc": {
    "description": "command draw circle ttr desc"
  },
  "command_draw_donut_desc": "Draws a filled ring from an inside and outside diameter. A zero inside diameter is a filled disk. The result is a closed wide polyline, which is how DWG stores a donut.",
  "@command_draw_donut_desc": {
    "description": "command draw donut desc"
  },
  "command_draw_arc_desc": "Draws a circular arc through three points: start, a point on the arc, and end.",
  "@command_draw_arc_desc": {
    "description": "command draw arc desc"
  },
  "command_draw_polygon_desc": "Draws a regular polygon inscribed in a circle.",
  "@command_draw_polygon_desc": {
    "description": "command draw polygon desc"
  },
  "command_draw_ellipse_desc": "Draws an ellipse from a centre, one axis endpoint, and the distance to the other axis.",
  "@command_draw_ellipse_desc": {
    "description": "command draw ellipse desc"
  },
  "command_draw_xline_desc": "Draws an infinite construction line through a point in a given direction. The second point only sets the angle; both sides extend without end.",
  "@command_draw_xline_desc": {
    "description": "command draw xline desc"
  },
  "command_draw_ray_desc": "Draws a semi-infinite ray from a start point through a second point. Unlike XLINE, it has a beginning.",
  "@command_draw_ray_desc": {
    "description": "command draw ray desc"
  },
  "command_draw_point_desc": "Places a point marker.",
  "@command_draw_point_desc": {
    "description": "command draw point desc"
  },
  "command_draw_divide_desc": "Places point markers that split a line, polyline, arc or circle into equal segments. Open objects leave the endpoints unmarked; a circle or closed polyline places a marker at every interval. A bulge is followed as its arc, not the chord.",
  "@command_draw_divide_desc": {
    "description": "command draw divide desc"
  },
  "command_draw_measure_desc": "Places point markers at a fixed spacing along a line, polyline, arc or circle. Open objects start from the nearer end; a circle starts at the pick. Endpoints are not marked. A bulge is followed as its arc, not the chord.",
  "@command_draw_measure_desc": {
    "description": "command draw measure desc"
  },
  "command_draw_text_desc": "Places a single line of text. Style defaults to the current TEXTSTYLE. Justify is Left, Center, Right or a corner code such as TL.",
  "@command_draw_text_desc": {
    "description": "command draw text desc"
  },
  "command_draw_mtext_desc": "Places multiline text. Newlines become \\P. Width 0 does not wrap. Justify is TL…BR or attachment 1–9 (1 is top-left).",
  "@command_draw_mtext_desc": {
    "description": "command draw mtext desc"
  },
  "command_draw_attdef_desc": "Places an attribute definition. Include it in a BLOCK so INSERT and ATTEDIT can fill the tag — title blocks and schedules.",
  "@command_draw_attdef_desc": {
    "description": "command draw attdef desc"
  },
  "command_draw_leader_desc": "Draws a leader from an arrow tip through one or more vertices. Optional annotation text sits on a horizontal landing at the last point, the same way AutoCAD LEADER places a callout.",
  "@command_draw_leader_desc": {
    "description": "command draw leader desc"
  },
  "command_draw_hatch_desc": "Fills the area around an internal point, or around selected closed boundaries. Four lines that meet still count as a boundary.",
  "@command_draw_hatch_desc": {
    "description": "command draw hatch desc"
  },
  "command_draw_dim_linear_desc": "Places a horizontal or vertical dimension. The dimension-line pick chooses the axis: above or below the origins measures width; left or right measures height. A line can stand in for the two origins.",
  "@command_draw_dim_linear_desc": {
    "description": "command draw dim linear desc"
  },
  "command_draw_dim_aligned_desc": "Places a dimension parallel to the two origins. The text is the true distance, not the horizontal or vertical component. A line can stand in for the two origins.",
  "@command_draw_dim_aligned_desc": {
    "description": "command draw dim aligned desc"
  },
  "command_draw_dim_radius_desc": "Places a radius dimension on a circle or arc. The second pick is the arrow tip; the text is the radius, prefixed with R.",
  "@command_draw_dim_radius_desc": {
    "description": "command draw dim radius desc"
  },
  "command_draw_dim_diameter_desc": "Places a diameter dimension on a circle or arc. The second pick is the arrow tip; the text is the diameter, prefixed with Ø.",
  "@command_draw_dim_diameter_desc": {
    "description": "command draw dim diameter desc"
  },
  "command_draw_center_mark_desc": "Draws a centre mark on selected circles or arcs. A short cross sits on the centre; optional extensions continue past the circumference, the usual shop-drawing DIMCENTER.",
  "@command_draw_center_mark_desc": {
    "description": "command draw center mark desc"
  },
  "command_draw_center_line_desc": "Draws a centreline between two parallel lines, or through the centres of two circles or arcs. The line spans both objects and extends a little past each end.",
  "@command_draw_center_line_desc": {
    "description": "command draw center line desc"
  },
  "command_draw_dim_angular_desc": "Places an angular dimension. Pick an arc and its centre is the vertex; pick two lines and their intersection is the vertex; the last pick sits on the dimension arc and chooses which sector is labelled. Three points still work when a vertex is supplied.",
  "@command_draw_dim_angular_desc": {
    "description": "command draw dim angular desc"
  },
  "command_draw_dim_continue_desc": "Places the next linear or aligned dimension from the previous second origin, on the same dimension line. Chain several next points to walk a row of features.",
  "@command_draw_dim_continue_desc": {
    "description": "command draw dim continue desc"
  },
  "command_draw_dim_baseline_desc": "Places the next linear or aligned dimension from the same first origin, on a dimension line stepped outward. Chain several next points to stack overall lengths.",
  "@command_draw_dim_baseline_desc": {
    "description": "command draw dim baseline desc"
  },
  "command_annot_dimstyle_desc": "Creates or edits a dimension style. Regenerated dimensions read text height, arrow size, extension offsets, scale and decimal places from the named style. Omit the name to list styles or to edit the current one.",
  "@command_annot_dimstyle_desc": {
    "description": "command annot dimstyle desc"
  },
  "command_annot_textstyle_desc": "Creates or edits a text style. New TEXT and MTEXT read the font, fixed height, width factor and oblique from the named style. Omit the name to list styles or to edit the current one.",
  "@command_annot_textstyle_desc": {
    "description": "command annot textstyle desc"
  },
  "command_edit_erase_desc": "Deletes the selected objects.",
  "@command_edit_erase_desc": {
    "description": "command edit erase desc"
  },
  "command_edit_overkill_desc": "Deletes exact geometric duplicates and folds overlapping or abutting collinear lines into one stroke. The first copy is kept and stretched to the union. Omitted ids means the whole current space, so a leftover selection cannot hide the rest of the duplicates.",
  "@command_edit_overkill_desc": {
    "description": "command edit overkill desc"
  },
  "command_edit_move_desc": "Moves the selected objects by a displacement.",
  "@command_edit_move_desc": {
    "description": "command edit move desc"
  },
  "command_edit_copy_desc": "Copies the selected objects to one or more locations. Each second point is another copy from the same base; Escape finishes.",
  "@command_edit_copy_desc": {
    "description": "command edit copy desc"
  },
  "command_edit_copy_clip_desc": "Copies the selected objects to the clipboard. The lower-left of the selection is the paste base. Paste in this drawing or another tab with PASTECLIP.",
  "@command_edit_copy_clip_desc": {
    "description": "command edit copy clip desc"
  },
  "command_edit_copy_base_desc": "Copies the selected objects to the clipboard with a base point you pick, so PASTECLIP can land that point on the insertion.",
  "@command_edit_copy_base_desc": {
    "description": "command edit copy base desc"
  },
  "command_edit_cut_clip_desc": "Copies the selected objects to the clipboard and deletes them from the drawing. Objects on a locked layer stay; the clipboard still holds a copy.",
  "@command_edit_cut_clip_desc": {
    "description": "command edit cut clip desc"
  },
  "command_edit_paste_clip_desc": "Pastes clipboard objects at an insertion point. The stored base point lands on that click.",
  "@command_edit_paste_clip_desc": {
    "description": "command edit paste clip desc"
  },
  "command_edit_paste_orig_desc": "Pastes clipboard objects at the coordinates they had in the source drawing, without asking for an insertion point.",
  "@command_edit_paste_orig_desc": {
    "description": "command edit paste orig desc"
  },
  "command_edit_paste_block_desc": "Pastes clipboard objects as one anonymous block reference. The stored base point lands on the insertion point you pick.",
  "@command_edit_paste_block_desc": {
    "description": "command edit paste block desc"
  },
  "command_edit_stretch_desc": "Moves vertices inside a crossing window and leaves the rest anchored. Objects wholly captured by the window move as a body.",
  "@command_edit_stretch_desc": {
    "description": "command edit stretch desc"
  },
  "command_edit_rotate_desc": "Rotates the selected objects about a base point. The angle is in degrees, counter-clockwise.",
  "@command_edit_rotate_desc": {
    "description": "command edit rotate desc"
  },
  "command_edit_scale_desc": "Scales the selected objects uniformly about a base point.",
  "@command_edit_scale_desc": {
    "description": "command edit scale desc"
  },
  "command_edit_mirror_desc": "Mirrors the selected objects across a line.",
  "@command_edit_mirror_desc": {
    "description": "command edit mirror desc"
  },
  "command_edit_align_desc": "Moves the selection so a source point lands on a destination point. A second pair rotates to match the two directions; an optional scale matches the two lengths.",
  "@command_edit_align_desc": {
    "description": "command edit align desc"
  },
  "command_edit_array_desc": "Creates a rectangular grid of copies of the selected objects.",
  "@command_edit_array_desc": {
    "description": "command edit array desc"
  },
  "command_edit_polar_array_desc": "Creates copies of the selected objects rotated about a centre. A fill of 360° spaces items around the full circle; a smaller fill spaces them from the original through that angle, inclusive.",
  "@command_edit_polar_array_desc": {
    "description": "command edit polar array desc"
  },
  "command_edit_offset_desc": "Creates parallel copies of lines, arcs, circles and polylines at a fixed distance.",
  "@command_edit_offset_desc": {
    "description": "command edit offset desc"
  },
  "command_edit_trim_desc": "Shortens a line, polyline or arc back to where it crosses the selected cutting edges. The part containing the pick point is removed. A closed polyline opens; a bulge is cut on the arc, not the chord.",
  "@command_edit_trim_desc": {
    "description": "command edit trim desc"
  },
  "command_edit_extend_desc": "Lengthens a line, open polyline or arc until it meets the selected boundary edges. A bulge grows along its circle. On a polyline or arc the pick chooses which end moves.",
  "@command_edit_extend_desc": {
    "description": "command edit extend desc"
  },
  "command_edit_fillet_desc": "Rounds the corner between two lines, or vertices of a polyline, with an arc of a given radius. Pass all=true to fillet every straight corner of a polyline. A radius of zero trims or extends two lines to a sharp corner.",
  "@command_edit_fillet_desc": {
    "description": "command edit fillet desc"
  },
  "command_edit_chamfer_desc": "Cuts a straight bevel between two lines, or at vertices of a polyline. Pass all=true to chamfer every straight corner. The two distances are measured from the corner back along each segment; omit the second to use the same length on both.",
  "@command_edit_chamfer_desc": {
    "description": "command edit chamfer desc"
  },
  "command_edit_break_desc": "Splits a line, polyline or arc at a point, or removes the portion between two points. A bulge is split into two smaller arcs. A circle needs two points and keeps the counter-clockwise remnant from the second pick back to the first. Omit the second point to only split (arcs and open chains).",
  "@command_edit_break_desc": {
    "description": "command edit break desc"
  },
  "command_edit_lengthen_desc": "Changes the length of a line, open polyline or arc by moving the end you pick. A bulge grows or shrinks along its arc. Supply a total length, or a signed delta to add to the current length. An arc cannot be closed into a full circle.",
  "@command_edit_lengthen_desc": {
    "description": "command edit lengthen desc"
  },
  "command_edit_explode_desc": "Breaks polylines into their segments, block references into copies of their contents, and dimensions into the lines, arrows and text they draw.",
  "@command_edit_explode_desc": {
    "description": "command edit explode desc"
  },
  "command_edit_block_desc": "Defines a named block from selected objects and replaces them with one insert at the base point, so the drawing looks the same and the definition can be inserted again.",
  "@command_edit_block_desc": {
    "description": "command edit block desc"
  },
  "command_edit_insert_desc": "Places one or more references to a named block. Scale is uniform; rotation is in degrees. Pass a points array to stamp the same block at several locations.",
  "@command_edit_insert_desc": {
    "description": "command edit insert desc"
  },
  "command_edit_minsert_desc": "Places a rectangular array of a named block as one insert. The copies stay one object, so moving the insert moves the whole grid.",
  "@command_edit_minsert_desc": {
    "description": "command edit minsert desc"
  },
  "command_block_purge_desc": "Deletes named block definitions that no insert references. Nested unused definitions are removed in the same pass, so a block that only existed inside another unused block is cleared too. Xrefs and layout blocks are left alone.",
  "@command_block_purge_desc": {
    "description": "command block purge desc"
  },
  "command_block_rename_desc": "Renames a block definition and every insert that still points at the old name. Layout blocks, anonymous blocks and xrefs cannot be renamed.",
  "@command_block_rename_desc": {
    "description": "command block rename desc"
  },
  "command_edit_join_desc": "Joins selected lines, arcs and open polylines whose endpoints meet into a single polyline. A piece is reversed when that is how it touches the chain; a loop whose ends meet is stored closed.",
  "@command_edit_join_desc": {
    "description": "command edit join desc"
  },
  "command_edit_close_desc": "Closes the selected open polylines by connecting the last vertex back to the first. Already-closed polylines are left alone.",
  "@command_edit_close_desc": {
    "description": "command edit close desc"
  },
  "command_edit_open_desc": "Opens the selected closed polylines by dropping the closing segment. The vertices stay; only the loop is broken.",
  "@command_edit_open_desc": {
    "description": "command edit open desc"
  },
  "command_edit_polyline_width_desc": "Sets the constant width of selected polylines. Zero is a hairline; a donut is the same field, so this is how a wide stroke is edited after it is drawn.",
  "@command_edit_polyline_width_desc": {
    "description": "command edit polyline width desc"
  },
  "command_edit_hatch_desc": "Changes the pattern, scale or angle of selected hatches. Omit a field to leave it. Angle is in degrees.",
  "@command_edit_hatch_desc": {
    "description": "command edit hatch desc"
  },
  "command_edit_to_polyline_desc": "Turns selected lines into two-vertex polylines so they can be closed, opened or reversed as a chain.",
  "@command_edit_to_polyline_desc": {
    "description": "command edit to polyline desc"
  },
  "command_edit_reverse_desc": "Reverses the direction of selected lines and polylines. The drawn shape stays the same; start and end swap, which matters for linetypes and for commands that follow a chain.",
  "@command_edit_reverse_desc": {
    "description": "command edit reverse desc"
  },
  "command_edit_undo_desc": "Reverses the most recent change.",
  "@command_edit_undo_desc": {
    "description": "command edit undo desc"
  },
  "command_edit_redo_desc": "Re-applies the most recently undone change.",
  "@command_edit_redo_desc": {
    "description": "command edit redo desc"
  },
  "command_edit_change_layer_desc": "Moves the selected objects onto a different layer.",
  "@command_edit_change_layer_desc": {
    "description": "command edit change layer desc"
  },
  "command_edit_change_color_desc": "Sets the colour of the selected objects. Accepts an AutoCAD Color Index (1-255), a #rrggbb value, or ByLayer.",
  "@command_edit_change_color_desc": {
    "description": "command edit change color desc"
  },
  "command_edit_change_linetype_desc": "Sets the linetype of the selected objects. Stock names (DASHED, HIDDEN, CENTER, PHANTOM, DOT, DASHDOT, DIVIDE, Continuous) are added to the drawing if they are not there yet. ByLayer and ByBlock inherit instead.",
  "@command_edit_change_linetype_desc": {
    "description": "command edit change linetype desc"
  },
  "command_edit_change_lineweight_desc": "Sets the lineweight of the selected objects. Accepts a millimetre value (0.25), hundredths (25), ByLayer, ByBlock, Default or hairline.",
  "@command_edit_change_lineweight_desc": {
    "description": "command edit change lineweight desc"
  },
  "command_edit_dimension_text_desc": "Overrides the text of selected dimensions. Empty restores the measured value; <> stands for that value; a single space hides the text.",
  "@command_edit_dimension_text_desc": {
    "description": "command edit dimension text desc"
  },
  "command_edit_dim_tedit_desc": "Moves the text of selected dimensions to a new point. On a linear dimension the dimension line follows without flipping width and height; aligned, radial and angular dimensions keep their type.",
  "@command_edit_dim_tedit_desc": {
    "description": "command edit dim tedit desc"
  },
  "command_edit_text_content_desc": "Changes the content of selected text, mtext, dimensions, attributes or leaders. On a dimension, empty restores the measured value and <> stands for that value, same as DIMEDIT.",
  "@command_edit_text_content_desc": {
    "description": "command edit text content desc"
  },
  "command_edit_text_object_desc": "Updates content, height, colour, justification, rotation, style, column width, width factor or oblique of selected text, mtext, attributes or leaders in one undo. Dimension text height is a dimstyle property and is ignored.",
  "@command_edit_text_object_desc": {
    "description": "command edit text object desc"
  },
  "command_edit_justify_text_desc": "Changes the justification of selected text or mtext and moves the insertion point so the letters stay where they are. Align and Fit are not offered; they need a second point.",
  "@command_edit_justify_text_desc": {
    "description": "command edit justify text desc"
  },
  "command_edit_match_prop_desc": "Copies layer, colour, linetype, lineweight and the other display properties from a source object onto the destination objects. Visibility is left alone so isolate and hide stay intact.",
  "@command_edit_match_prop_desc": {
    "description": "command edit match prop desc"
  },
  "command_edit_attedit_desc": "Changes the values on a block reference. Constant tags stay as the definition wrote them.",
  "@command_edit_attedit_desc": {
    "description": "command edit attedit desc"
  },
  "command_view_zoom_extents_desc": "Fits the whole drawing in the window.",
  "@command_view_zoom_extents_desc": {
    "description": "command view zoom extents desc"
  },
  "command_view_zoom_window_desc": "Zooms to a rectangle you specify.",
  "@command_view_zoom_window_desc": {
    "description": "command view zoom window desc"
  },
  "command_view_zoom_in_desc": "Magnifies the view about its centre.",
  "@command_view_zoom_in_desc": {
    "description": "command view zoom in desc"
  },
  "command_view_zoom_out_desc": "Shrinks the view about its centre.",
  "@command_view_zoom_out_desc": {
    "description": "command view zoom out desc"
  },
  "command_view_zoom_selected_desc": "Fits the selected objects in the window.",
  "@command_view_zoom_selected_desc": {
    "description": "command view zoom selected desc"
  },
  "command_view_regen_desc": "Rebuilds the display list, discarding cached curve tessellations.",
  "@command_view_regen_desc": {
    "description": "command view regen desc"
  },
  "command_view_units_desc": "Sets the drawing insertion units written to $INSUNITS. Coordinates stay in these units; the value is what importers and queries use to convert.",
  "@command_view_units_desc": {
    "description": "command view units desc"
  },
  "command_workbench_preferences_desc": "Opens the application settings dialog.",
  "@command_workbench_preferences_desc": {
    "description": "command workbench preferences desc"
  },
  "command_select_all_desc": "Selects every selectable object in the current space.",
  "@command_select_all_desc": {
    "description": "command select all desc"
  },
  "command_select_none_desc": "Clears the selection.",
  "@command_select_none_desc": {
    "description": "command select none desc"
  },
  "command_select_invert_desc": "Selects everything that is not currently selected.",
  "@command_select_invert_desc": {
    "description": "command select invert desc"
  },
  "command_select_similar_desc": "Extends the selection to every object of the same type and layer.",
  "@command_select_similar_desc": {
    "description": "command select similar desc"
  },
  "command_select_by_layer_desc": "Selects every object on a named layer.",
  "@command_select_by_layer_desc": {
    "description": "command select by layer desc"
  },
  "command_select_by_color_desc": "Selects every object whose stored colour matches an ACI, #rrggbb, ByLayer or ByBlock. Layer-inherited red is not the same as ACI 1.",
  "@command_select_by_color_desc": {
    "description": "command select by color desc"
  },
  "command_select_by_linetype_desc": "Selects every object whose stored linetype matches a name, ByLayer or ByBlock. Layer-inherited DASHED is not the same as DASHED.",
  "@command_select_by_linetype_desc": {
    "description": "command select by linetype desc"
  },
  "command_select_by_lineweight_desc": "Selects every object whose stored lineweight matches a millimetre value, hundredths, ByLayer, ByBlock, Default or hairline. Layer-inherited 0.25 mm is not the same as 25.",
  "@command_select_by_lineweight_desc": {
    "description": "command select by lineweight desc"
  },
  "command_select_by_type_desc": "Selects every object of one entity kind in the current space. LINE, CIRCLE, INSERT, DIMENSION and the other FanCAD kinds work; LWPOLYLINE and BLOCK are accepted as polyline and insert.",
  "@command_select_by_type_desc": {
    "description": "command select by type desc"
  },
  "command_select_by_block_desc": "Selects every insert of a named block in the current space. The name is case-insensitive, the same way INSERT and RENAME look it up.",
  "@command_select_by_block_desc": {
    "description": "command select by block desc"
  },
  "command_view_isolate_objects_desc": "Hides every object in the current space except the selection, so the rest of the drawing is out of the way without being deleted.",
  "@command_view_isolate_objects_desc": {
    "description": "command view isolate objects desc"
  },
  "command_view_hide_objects_desc": "Hides the selected objects without deleting them.",
  "@command_view_hide_objects_desc": {
    "description": "command view hide objects desc"
  },
  "command_view_unisolate_objects_desc": "Shows every object that Isolate or Hide had turned off in the current space.",
  "@command_view_unisolate_objects_desc": {
    "description": "command view unisolate objects desc"
  },
  "command_layer_new_desc": "Creates a layer and makes it current.",
  "@command_layer_new_desc": {
    "description": "command layer new desc"
  },
  "command_layer_set_current_desc": "Chooses the layer new objects are created on.",
  "@command_layer_set_current_desc": {
    "description": "command layer set current desc"
  },
  "command_layer_toggle_visible_desc": "Turns a layer on or off.",
  "@command_layer_toggle_visible_desc": {
    "description": "command layer toggle visible desc"
  },
  "command_layer_isolate_desc": "Turns off every layer except the named one.",
  "@command_layer_isolate_desc": {
    "description": "command layer isolate desc"
  },
  "command_layer_show_all_desc": "Turns every layer back on.",
  "@command_layer_show_all_desc": {
    "description": "command layer show all desc"
  },
  "command_layer_toggle_lock_desc": "Locks or unlocks a layer. Objects on a locked layer stay visible but cannot be modified.",
  "@command_layer_toggle_lock_desc": {
    "description": "command layer toggle lock desc"
  },
  "command_layer_delete_desc": "Deletes a layer and everything on it. The layer named 0 cannot be deleted.",
  "@command_layer_delete_desc": {
    "description": "command layer delete desc"
  },
  "command_layer_purge_desc": "Deletes layers that no object uses. Layer 0 is kept, and if the current layer is empty it is switched back to 0 before the purge.",
  "@command_layer_purge_desc": {
    "description": "command layer purge desc"
  },
  "command_query_summary_desc": "Returns a compact statistical summary of the drawing: extents, entity counts by type, and per-layer counts. Use this first to understand a drawing before querying its contents.",
  "@command_query_summary_desc": {
    "description": "command query summary desc"
  },
  "command_query_list_desc": "Reports the full properties of the selected objects.",
  "@command_query_list_desc": {
    "description": "command query list desc"
  },
  "command_query_entities_desc": "Finds entities matching optional filters and returns their ids and properties. Use layer, kind and a bounding window to narrow a large drawing to the part you care about.",
  "@command_query_entities_desc": {
    "description": "command query entities desc"
  },
  "command_query_selection_desc": "Returns the current selection as structured records (id, kind, layer, bounds, short geometry). Use this instead of guessing ids. An empty selection is a successful empty list, not a prompt.",
  "@command_query_selection_desc": {
    "description": "command query selection desc"
  },
  "command_query_viewport_desc": "Returns the active camera: centre, scale and visible window as [minX, minY, maxX, maxY]. Pass that window to query.entities to list what the user is looking at.",
  "@command_query_viewport_desc": {
    "description": "command query viewport desc"
  },
  "command_query_id_desc": "Reports the X and Y coordinates of a point. Use this when you need a location, not a distance between two locations.",
  "@command_query_id_desc": {
    "description": "command query id desc"
  },
  "command_query_distance_desc": "Measures the distance and angle between two points.",
  "@command_query_distance_desc": {
    "description": "command query distance desc"
  },
  "command_query_angle_desc": "Measures the angle at a vertex between two rays. The first point is the vertex; the next two define the sides.",
  "@command_query_angle_desc": {
    "description": "command query angle desc"
  },
  "command_query_area_desc": "Reports the area and perimeter of the selected closed objects.",
  "@command_query_area_desc": {
    "description": "command query area desc"
  },
  "command_query_layers_desc": "Returns every layer with its state and object count.",
  "@command_query_layers_desc": {
    "description": "command query layers desc"
  },
  "command_layout_list_desc": "Lists model and paper-space layouts and their viewports.",
  "@command_layout_list_desc": {
    "description": "command layout list desc"
  },
  "command_layout_set_desc": "Switches the active layout (Model or a paper tab).",
  "@command_layout_set_desc": {
    "description": "command layout set desc"
  },
  "command_layout_new_desc": "Adds a paper-space layout tab and opens it. The sheet defaults to A4 landscape; pass width and height in millimetres to override.",
  "@command_layout_new_desc": {
    "description": "command layout new desc"
  },
  "command_layout_delete_desc": "Removes a paper-space layout tab and the entities on that sheet. Model cannot be deleted. Omit the name to delete the current tab.",
  "@command_layout_delete_desc": {
    "description": "command layout delete desc"
  },
  "command_layout_copy_desc": "Duplicates a paper layout: sheet size, viewports, and the entities on that sheet. Model cannot be copied.",
  "@command_layout_copy_desc": {
    "description": "command layout copy desc"
  },
  "command_layout_rename_desc": "Renames a paper layout tab. The sheet, viewports and paper entities stay put. Model cannot be renamed.",
  "@command_layout_rename_desc": {
    "description": "command layout rename desc"
  },
  "command_layout_order_desc": "Moves a paper tab in the layout strip. Model stays first. index is the destination among paper tabs (0 = first paper). Or pass before / after another tab name.",
  "@command_layout_order_desc": {
    "description": "command layout order desc"
  },
  "command_layout_pagesetup_desc": "Changes the paper size of a layout, in millimetres, the plot rotation (0, 90, 180 or 270), scale or fit-to-sheet, an offset, and an optional plot window. Omit the name to edit the current paper tab. Model has no sheet.",
  "@command_layout_pagesetup_desc": {
    "description": "command layout pagesetup desc"
  },
  "command_layout_mview_desc": "Cuts a window on the current paper layout that looks into model space. The model is framed in the rectangle unless a scale is supplied.",
  "@command_layout_mview_desc": {
    "description": "command layout mview desc"
  },
  "command_layout_vpscale_desc": "Sets the scale of a paper viewport (model units per paper unit). Pass fit=true to frame the model again. A locked viewport is refused.",
  "@command_layout_vpscale_desc": {
    "description": "command layout vpscale desc"
  },
  "command_layout_vplock_desc": "Locks or unlocks a paper viewport so VPSCALE cannot change the view. Omit locked to toggle. The window frame can still move.",
  "@command_layout_vplock_desc": {
    "description": "command layout vplock desc"
  },
  "command_layout_vpon_desc": "Turns a paper viewport on or off. An off window keeps its frame but hides the model and is skipped when plotting. Omit on to toggle.",
  "@command_layout_vpon_desc": {
    "description": "command layout vpon desc"
  },
  "command_layout_vplayer_desc": "Freezes or thaws layers in one paper viewport. Other windows and model space keep their own visibility. Omit freeze to freeze.",
  "@command_layout_vplayer_desc": {
    "description": "command layout vplayer desc"
  },
  "command_layout_vpmax_desc": "Opens model space framed to a paper viewport so the model can be edited through that window. VPMIN returns to the sheet.",
  "@command_layout_vpmax_desc": {
    "description": "command layout vpmax desc"
  },
  "command_layout_vpmin_desc": "Returns to the paper layout left by VPMAX and frames the sheet.",
  "@command_layout_vpmin_desc": {
    "description": "command layout vpmin desc"
  },
  "command_print_export_svg_desc": "Plots a layout to an SVG file. Omit the layout name to plot the current tab. A .pdf path writes a vector PDF instead. Pass corner1 and corner2 to plot a window; otherwise the layout's stored plot window or the full sheet is used.",
  "@command_print_export_svg_desc": {
    "description": "command print export svg desc"
  },
  "command_print_export_pdf_desc": "Plots a layout to a vector PDF. Omit the layout name to plot the current tab. Paper size becomes the page MediaBox; viewports are clipped. Pass corner1 and corner2 to plot a window.",
  "@command_print_export_pdf_desc": {
    "description": "command print export pdf desc"
  },
  "command_xref_attach_desc": "Loads another drawing as an external reference and places it in model space. Reload by attaching the same path again; existing inserts keep their position.",
  "@command_xref_attach_desc": {
    "description": "command xref attach desc"
  },
  "command_xref_reload_desc": "Re-reads attached external references from their stored paths. Omit the name to reload the selected xref, or the only xref in the drawing.",
  "@command_xref_reload_desc": {
    "description": "command xref reload desc"
  },
  "command_xref_detach_desc": "Removes an external reference and every insert that shows it. Omit the name to detach the selected xref, or the only xref in the drawing.",
  "@command_xref_detach_desc": {
    "description": "command xref detach desc"
  },
  "command_xref_bind_desc": "Turns an external reference into a local block so the drawing no longer depends on that file. Inserts stay where they are. Omit the name to bind the selected xref, or the only xref in the drawing.",
  "@command_xref_bind_desc": {
    "description": "command xref bind desc"
  },
